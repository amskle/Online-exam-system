# ============================================================
# Docker 部署环境变量
# ============================================================
# 复制此文件为 .env.docker，填入真实值后：
#   docker compose --env-file .env.docker up --build
# 注意：.env.docker 已被 .gitignore 忽略，不会提交到仓库

# ── MySQL ──
MYSQL_ROOT_PASSWORD=

# ── 应用数据库账号（由 MySQL 首次启动时创建，请勿使用 root）──
DB_USERNAME=exam_app
DB_PASSWORD=

# ── 初始管理员（账号固定为 admin，首次启动时创建）──
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=admin@example.com

# ── JWT 密钥（backend 和 ai-tutor 必须一致，生产环境请生成随机字符串）──
JWT_SECRET=

# ── 邮件（QQ SMTP 授权码）──
MAIL_USERNAME=your-mail-address@qq.com
MAIL_AUTH_CODE=your-mail-auth-code-here

# ── LLM API（默认阿里 DashScope OpenAI 兼容模式，可改用其他兼容服务）──
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash-2026-07-15
LLM_API_KEY=

# ── Embedding API（默认复用 LLM 凭据走 DashScope text-embedding-v4）──
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_USE_LLM_CREDENTIALS=true
# DashScope text-embedding-v4 单次批量上限为 10
EMBEDDING_BATCH_SIZE=10
EMBEDDING_API_KEY=

# ── RAG 分块与检索（可选）──
USE_UNSTRUCTURED=false
NOTES_SOFT_TOKEN_LIMIT=256
NOTES_HARD_TOKEN_LIMIT=400
CHUNK_OVERLAP_RATIO=0.15
MIN_CHUNK_TOKENS=50
HYBRID_TOP_K=20
KEYWORD_MAX_DOCS=50000
MAX_UPLOAD_MB=50
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_VARIANTS=5
QUERY_REWRITE_HISTORY_LIMIT=6

# 允许跨域的本地开发来源；同源生产部署通常无需增加域名
CORS_ALLOWED_ORIGINS=http://localhost:8076,http://localhost:8088

# ========== 智能学习伙伴 (ai-tutor) 配置文件 ==========

# ── 服务 ──
APP_NAME=ai-tutor
APP_PORT=8080
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:8076,http://localhost:8088

# ── JWT（必须与 Spring Boot exam-backend 一致）──
JWT_SECRET=
JWT_ALGORITHM=HS256

# ── 考试系统后端地址 ──
EXAM_BACKEND_URL=http://localhost:8077

# ── LLM API（国内模型，OpenAI-compatible）──
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
# ── Embedding API（需单独配置，DeepSeek 不提供 embedding 服务）──
# 推荐 SiliconFlow（免费额度）或本地模型
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 同一 OpenAI-compatible 提供商同时支持聊天与向量时，可安全复用 LLM 凭据。
EMBEDDING_USE_LLM_CREDENTIALS=false
EMBEDDING_MAX_CHARS=8000
# 单批向量化的文本数，需≤所用提供商上限（DashScope text-embedding-v4 为 10，SiliconFlow bge 可更大）
EMBEDDING_BATCH_SIZE=32

# ── ChromaDB 向量存储 ──
VECTOR_DB_PATH=./chroma_store

# ── SQLite 会话存储 ──
SESSION_DB_PATH=./chat_sessions.db

# ── Langfuse（自托管）──
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=ai-tutor-0.2.0
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TRACE_TESTS=false

# Agent Dataset 中不保存 JWT；需要调用后端时从本地注入。
EVAL_STUDENT_TOKEN=
EVAL_TEACHER_TOKEN=

# ── RAG 参数 ──
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
USE_UNSTRUCTURED=false
DOCUMENT_CLASSIFIER=rule
NOTES_SOFT_TOKEN_LIMIT=256
NOTES_HARD_TOKEN_LIMIT=400
CHUNK_OVERLAP_RATIO=0.15
MIN_CHUNK_TOKENS=50
HYBRID_TOP_K=20
KEYWORD_MAX_DOCS=50000
KEYWORD_QUERY_TIMEOUT_MS=250
KEYWORD_FALLBACK_MAX_DOCS=5000
KEYWORD_FALLBACK_TIMEOUT_MS=100
MAX_UPLOAD_MB=50
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=5
RETRIEVAL_SEMANTIC_TIMEOUT_MS=1000
RETRIEVAL_MIN_SIMILARITY=0.60
RETRIEVAL_EARLY_STOP_SIMILARITY=0.82
RETRIEVAL_EARLY_STOP_MIN_RESULTS=3
RETRIEVAL_MIN_KEYWORD_SCORE=0.25
RETRIEVAL_CACHE_TTL_SECONDS=60
RETRIEVAL_CACHE_SIZE=256
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_VARIANTS=5
QUERY_REWRITE_HISTORY_LIMIT=6
QUERY_REWRITE_CONCURRENCY=3
QUERY_REWRITE_TIMEOUT_SECONDS=0.5
QUERY_REWRITE_CACHE_SIZE=256
QUERY_COMPLEXITY_LENGTH_THRESHOLD=80

# ── Agent 参数 ──
LLM_TIMEOUT=60.0
GENERATE_BATCH_SIZE=5
GENERATE_MAX_ATTEMPTS=4
QUALITY_CHECK_MAX_ATTEMPTS=2
SESSION_HISTORY_LIMIT=12
SESSION_MAX_MESSAGES=50

# ── 评估参数 ──
EVAL_SAMPLE_COUNT=20
EVAL_LLM_TEMPERATURE=0.0
